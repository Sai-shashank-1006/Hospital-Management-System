<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%--
  Shared page chrome for signed-in pages.

  Navigation asks Role.canAccess() for each item, which is the same method
  AuthFilter uses to allow or deny the request. A hidden menu entry and a
  blocked URL therefore cannot disagree -- hiding the link is a convenience,
  the filter is the control.

  Dropdowns open on hover AND on :focus-within, so they are reachable by
  keyboard before app.js loads; app.js then adds click-toggle and Escape.

  Flash messages are read from the session and immediately removed, so
  refreshing the page does not show them again.
--%>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<c:set var="currentUser" value="${sessionScope.currentUser}" />
<c:set var="csrfToken" value="${sessionScope.csrfToken}" />
<c:set var="flashSuccess" value="${sessionScope.flashSuccess}" />
<c:set var="flashError" value="${sessionScope.flashError}" />
<c:remove var="flashSuccess" scope="session" />
<c:remove var="flashError" scope="session" />
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#1f6feb">
  <title>${empty pageTitle ? 'MediFlow' : pageTitle}</title>
  <link rel="stylesheet" href="${ctx}/css/style.css">
</head>
<body>

<header class="topbar">
  <div class="navshell">

    <a class="brand" href="${ctx}/dashboard">
      <%@ include file="logo.jspf" %>
      <span class="brand-text">Medi<span class="flow">Flow</span></span>
    </a>

    <ul class="nav">

      <li class="nav-item">
        <a href="${ctx}/dashboard"
           class="nav-link ${activeNav == 'dashboard' ? 'active' : ''}">Dashboard</a>
      </li>

      <c:if test="${currentUser.role.canAccess('/patients')}">
        <li class="nav-item ${activeNav == 'patients' ? 'active' : ''}">
          <button type="button" class="nav-toggle" aria-expanded="false" aria-haspopup="true">
            Patients
            <svg class="caret" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="M2 4.5 L6 8.5 L10 4.5" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="dropdown">
            <li><a href="${ctx}/patients/">
              <span class="dd-icon" aria-hidden="true">&#128203;</span>
              <span>All patients<span class="dd-sub">Browse and search records</span></span>
            </a></li>
            <li><a href="${ctx}/patients/new">
              <span class="dd-icon" aria-hidden="true">&#10133;</span>
              <span>Register patient<span class="dd-sub">Add a new record</span></span>
            </a></li>
          </ul>
        </li>
      </c:if>

      <c:if test="${currentUser.role.canAccess('/doctors')}">
        <li class="nav-item ${activeNav == 'doctors' ? 'active' : ''}">
          <button type="button" class="nav-toggle" aria-expanded="false" aria-haspopup="true">
            Doctors
            <svg class="caret" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="M2 4.5 L6 8.5 L10 4.5" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="dropdown">
            <li><a href="${ctx}/doctors/">
              <span class="dd-icon" aria-hidden="true">&#129658;</span>
              <span>Consulting roster<span class="dd-sub">Schedules and availability</span></span>
            </a></li>
            <li><a href="${ctx}/doctors/new">
              <span class="dd-icon" aria-hidden="true">&#10133;</span>
              <span>Add doctor<span class="dd-sub">New roster entry</span></span>
            </a></li>
          </ul>
        </li>
      </c:if>

      <c:if test="${currentUser.role.canAccess('/appointments')}">
        <li class="nav-item ${activeNav == 'appointments' ? 'active' : ''}">
          <button type="button" class="nav-toggle" aria-expanded="false" aria-haspopup="true">
            Appointments
            <svg class="caret" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="M2 4.5 L6 8.5 L10 4.5" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="dropdown">
            <li><a href="${ctx}/appointments/">
              <span class="dd-icon" aria-hidden="true">&#128197;</span>
              <span>All appointments<span class="dd-sub">Every booking</span></span>
            </a></li>
            <li><a href="${ctx}/appointments/new">
              <span class="dd-icon" aria-hidden="true">&#10133;</span>
              <span>Book appointment<span class="dd-sub">Schedule a consultation</span></span>
            </a></li>
          </ul>
        </li>
      </c:if>

      <c:if test="${currentUser.role.canAccess('/prescriptions')}">
        <li class="nav-item ${activeNav == 'prescriptions' ? 'active' : ''}">
          <button type="button" class="nav-toggle" aria-expanded="false" aria-haspopup="true">
            Prescriptions
            <svg class="caret" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="M2 4.5 L6 8.5 L10 4.5" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="dropdown">
            <li><a href="${ctx}/prescriptions/">
              <span class="dd-icon" aria-hidden="true">&#128138;</span>
              <span>All prescriptions<span class="dd-sub">Issued medicines</span></span>
            </a></li>
            <li><a href="${ctx}/prescriptions/new">
              <span class="dd-icon" aria-hidden="true">&#9997;</span>
              <span>Write prescription<span class="dd-sub">Record a consultation</span></span>
            </a></li>
          </ul>
        </li>
      </c:if>

      <c:if test="${currentUser.role.canAccess('/invoices')}">
        <li class="nav-item ${activeNav == 'invoices' ? 'active' : ''}">
          <button type="button" class="nav-toggle" aria-expanded="false" aria-haspopup="true">
            Billing
            <svg class="caret" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="M2 4.5 L6 8.5 L10 4.5" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="dropdown">
            <li><a href="${ctx}/invoices/">
              <span class="dd-icon" aria-hidden="true">&#129534;</span>
              <span>All invoices<span class="dd-sub">Paid and outstanding</span></span>
            </a></li>
            <li><a href="${ctx}/invoices/new">
              <span class="dd-icon" aria-hidden="true">&#10133;</span>
              <span>New invoice<span class="dd-sub">Raise a bill</span></span>
            </a></li>
          </ul>
        </li>
      </c:if>

      <c:if test="${currentUser.role.canAccess('/reports')}">
        <li class="nav-item">
          <a href="${ctx}/reports/"
             class="nav-link ${activeNav == 'reports' ? 'active' : ''}">Reports</a>
        </li>
      </c:if>

      <c:if test="${currentUser.role.canAccess('/users')}">
        <li class="nav-item">
          <a href="${ctx}/users/"
             class="nav-link ${activeNav == 'users' ? 'active' : ''}">Staff</a>
        </li>
      </c:if>

    </ul>

    <%-- The account menu is a .nav-item so app.js wires its open/close with the
         navigation dropdowns; only the avatar and caret sit in the bar, because
         the name, role and sign-out button previously needed ~220px that the
         pill does not have once an administrator's eight menu entries are in
         it -- which is what pushed the sign-out control outside the bar. --%>
    <div class="account nav-item">
      <button type="button" class="account-toggle" aria-expanded="false" aria-haspopup="true"
              title="<c:out value='${currentUser.fullName}' /> (<c:out value='${currentUser.role.label}' />)">
        <span class="avatar"><c:out value="${currentUser.initials}" /></span>
        <span class="sr-only">Account menu for <c:out value="${currentUser.fullName}" /></span>
        <svg class="caret" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
          <path d="M2 4.5 L6 8.5 L10 4.5" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <ul class="dropdown dropdown--end account-menu">
        <li class="account-card">
          <span class="avatar avatar-lg" aria-hidden="true"><c:out value="${currentUser.initials}" /></span>
          <span class="account-card-text">
            <span class="account-name"><c:out value="${currentUser.fullName}" /></span>
            <span class="account-role"><c:out value="${currentUser.role.label}" /></span>
          </span>
        </li>
        <li>
          <%-- Sign-out is a POST carrying the CSRF token, so another site cannot
               trigger it with a link or an image tag. --%>
          <form method="post" action="${ctx}/logout" class="inline-form">
            <input type="hidden" name="csrfToken" value="${csrfToken}">
            <button class="dd-action" type="submit">
              <span class="dd-icon" aria-hidden="true">&#8635;</span>
              <span>Sign out<span class="dd-sub">End this session</span></span>
            </button>
          </form>
        </li>
      </ul>
    </div>

  </div>
</header>

<main class="wrap">

  <c:if test="${not empty flashSuccess}">
    <div class="alert alert-success" role="status"><c:out value="${flashSuccess}" /></div>
  </c:if>
  <c:if test="${not empty flashError}">
    <div class="alert alert-error" role="alert"><c:out value="${flashError}" /></div>
  </c:if>

  <c:if test="${not empty errors}">
    <div class="alert alert-error" role="alert">
      <strong>Please correct the following:</strong>
      <ul>
        <c:forEach var="error" items="${errors}">
          <li><c:out value="${error}" /></li>
        </c:forEach>
      </ul>
    </div>
  </c:if>
