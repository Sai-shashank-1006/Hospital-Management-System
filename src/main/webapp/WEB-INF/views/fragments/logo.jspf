<%--
  MediFlow mark: a blue gradient blob carrying a rounded "M", with the teal
  flow arc sweeping around it.

  Inline SVG rather than an image file: it stays sharp at any size, adds no
  extra request, and costs well under a kilobyte.

  The gradient id is namespaced per instance. A page may show the mark more
  than once (the sign-in page has one in the brand panel and one for narrow
  screens), and repeating a raw id would be invalid HTML: every reference
  resolves to whichever element came first. Set logoVariant before including
  this file when a page uses it twice.
--%>
<c:set var="logoGradientId"
       value="mediflow-blob-${empty logoVariant ? 'main' : logoVariant}" />
<svg class="brand-logo" viewBox="0 0 64 64" role="img" aria-label="MediFlow" focusable="false">
  <defs>
    <linearGradient id="${logoGradientId}" x1="8%" y1="4%" x2="92%" y2="96%">
      <stop offset="0%" stop-color="#3b8bff"/>
      <stop offset="55%" stop-color="#2264e8"/>
      <stop offset="100%" stop-color="#17359f"/>
    </linearGradient>
  </defs>

  <%-- Organic blob with a soft tail at the lower right. --%>
  <path d="M33 4
           C48.5 4, 60 12.5, 60.5 27
           C60.9 38.5, 55.5 45.5, 49.5 49.5
           C46.8 51.3, 45.6 54.2, 44.6 57.4
           C43.5 61, 39.3 61.6, 37.4 58.4
           C35.7 55.5, 33 55.6, 29.5 55.6
           C14.5 55.6, 3.5 45, 3.5 30.5
           C3.5 15, 17.5 4, 33 4 Z"
        fill="url(#${logoGradientId})"/>

  <%-- Rounded "M" -- drawn as a stroked path so the joins stay soft. --%>
  <path d="M18.5 44.5 V29 C18.5 24, 24.5 22, 27.8 25.8 L32 30.8 L36.2 25.8
           C39.5 22, 45.5 24, 45.5 29 V44.5"
        fill="none" stroke="#ffffff" stroke-width="7.4"
        stroke-linecap="round" stroke-linejoin="round"/>

  <%-- The teal "flow" arc and its leading dot. --%>
  <path d="M49.5 23.5 C56 31, 53.5 44.5, 42.5 49.5"
        fill="none" stroke="#2fe3c9" stroke-width="4.4" stroke-linecap="round"/>
  <circle cx="47.6" cy="17.4" r="2.9" fill="#2fe3c9"/>
</svg>
