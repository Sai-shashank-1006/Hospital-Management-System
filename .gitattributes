# Normalise line endings so the repository always stores LF.
#
# This matters for CI: a shell script or Jenkinsfile checked out with CRLF on a
# Linux agent fails with confusing "\r: command not found" errors.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files must never be converted.
*.war  binary
*.jar  binary
*.png  binary
*.jpg  binary
*.gif  binary
*.pdf  binary
*.zip  binary
